# 首次启动前填写下列四项，不提供默认账号或密码。
ADMIN_USER=
ADMIN_PASS=
ROOMS_SECRET=
PG_CONN=

# 网络配置；回环名称只用于本机服务之间通信。
PORT=5000
ADMIN_PORT=9090
ADMIN_BIND=127.0.0.1
FRONTEND_PORT=8080
FRONTEND_BIND=127.0.0.1
TRUST_PROXY=0

# 根据自己的发布策略设置，默认不创建业务房间。
REQUIRE_ROOM_WHITELIST=0
DEFAULT_WHITELIST_ROOM=
ROOMS_API_URL=
ROOMS_API_BIND=

# 默认不修改系统 Nginx 配置。
NGINX_SITE_FILE=
